# ===========================================
# API Keys for Signal Finder
# ===========================================
# 1. Copy this file and rename it to:  .env
# 2. Replace the placeholder values with your real keys
# 3. Never commit the real .env file to git

# Twelve Data (REQUIRED for candles).
# Any of these layouts works; all configured keys are used with rotation/failover:
# TWELVE_DATA_API_KEYS=key1,key2,key3,key4
# TWELVE_DATA_API_KEY=a_single_key
# TWELVE_DATA_API_KEY_1=...  TWELVE_DATA_API_KEY_2=...  TWELVE_DATA_API_KEY_3=...  TWELVE_DATA_API_KEY_4=...
# TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Optional non-Gemini AI providers (verifier panel / picker)
# LOVABLE_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
