# Copy to .env for local development; never commit real secrets.
# Twelve Data credentials are server-side only; configured keys rotate in order.
TWELVE_DATA_API_KEYS=
TWELVE_DATA_API_KEY=
# TWELVE_DATA_API_KEY_1=
# TWELVE_DATA_API_KEY_2=

# Optional read-only post-trade forensic reviewer (no trade execution tools).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional MT5 bridge/admin authentication. Keep private in deployment secrets.
MT5_ADMIN_TOKEN=

# Optional Telegram alert delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
